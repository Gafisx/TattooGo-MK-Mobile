{
  "expo": {
    "name": "TattooGo MK",
    "slug": "tattoogo-mk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tattoogomk",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tattoogomk.app",
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      }
    },
    "android": {
      "package": "com.tattoogomk.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 200,
          "backgroundColor": "#0a0a0a",
          "dark": {
            "image": "./assets/images/splash-logo.png",
            "backgroundColor": "#0a0a0a"
          },
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O TattooGo MK acede às suas fotos para publicar trabalhos no portfólio.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "O TattooGo MK usa a câmara para a prova de vida e verificação de identidade.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O TattooGo MK usa a sua localização para definir o endereço do estúdio e detetar coordenadas simuladas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5b82fe6d-3c85-4bb3-898a-1b9620e639a4"
      }
    }
  }
}
