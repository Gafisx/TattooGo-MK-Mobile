# Public runtime configuration (safe to ship in the client bundle).
# Copy this file to `.env` and fill in your own values.
#
# NEVER put a secret key here (Clerk `sk_...`, Stripe `sk_...`, Supabase
# `service_role`, private PEM keys, ...). Any `EXPO_PUBLIC_*` value is inlined
# into the app bundle and readable by anyone. Secret keys belong on the backend.

# Existing TattooGo backend on Render.
EXPO_PUBLIC_API_URL=https://api.tattoogomk.com.br

# Clerk native auth publishable key (dashboard -> API keys).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
